# Menapoly Cut Cue configuration. Copy to .env (make setup does this). Never commit .env.

# --- Claude (optional; without a key the app runs in a clearly labeled local test mode) ---
ANTHROPIC_API_KEY=
CUTCUE_CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = more thorough and more tokens)
CUTCUE_CLAUDE_EFFORT=medium
# Server-side refusal fallback (beta); set 0 to disable
CUTCUE_CLAUDE_FALLBACKS=1
# Per-project AI spend cap in USD (editable per project in the UI)
CUTCUE_PROJECT_BUDGET_USD=5

# --- Transcription (local, CPU) ---
# faster-whisper | none   (none = import SRT/VTT captions instead)
CUTCUE_TRANSCRIBER=faster-whisper
# tiny | base | small | medium | large-v3 | distil-large-v3. On a 16 GB Intel Mac:
# base ~ fast drafts; small ~ better accuracy at roughly 2-3x the time.
CUTCUE_WHISPER_MODEL=base
CUTCUE_WHISPER_COMPUTE_TYPE=int8
# Leave empty for auto-detect, or e.g. en
CUTCUE_WHISPER_LANGUAGE=
# 0 = use all cores
CUTCUE_CPU_THREADS=0

# --- Rendering ---
# auto | libx264 | h264_videotoolbox  (auto uses the Mac hardware encoder for final exports when available)
CUTCUE_VIDEO_ENCODER=auto
CUTCUE_RENDER_TIMEOUT_S=21600

# --- Server ---
CUTCUE_HOST=127.0.0.1
CUTCUE_PORT=8000
# Optional single-user password (required if CUTCUE_HOST is not a loopback address)
CUTCUE_PASSWORD=
# Optional fixed secret so sign-ins survive restarts
CUTCUE_SECRET_KEY=
CUTCUE_DATA_DIR=./data
CUTCUE_MAX_UPLOAD_GB=20

# --- Optional cloud worker (off by default; also needs per-project approval in the UI) ---
CUTCUE_CLOUD_WORKER_URL=
CUTCUE_CLOUD_WORKER_TOKEN=
