# Local development only. Copy to .dev.vars (git-ignored). Never put production values here.
ENVIRONMENT=development
DEV_OWNER_EMAIL=owner@example.test
OWNER_EMAILS=owner@example.test
EDITOR_EMAILS=editor@example.test
# Local S3-compatible storage standing in for R2 (moto: `python -m moto.server -p 9000`).
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=menapoly-cue-media
S3_ACCESS_KEY_ID=local-dev
S3_SECRET_ACCESS_KEY=local-dev-secret
LEASE_SECONDS=180
